{
    "compilerOptions": {
        "moduleResolution": "node",
        "target": "ES6",
        "strict": true,
        "module": "CommonJS",
        "lib": [
            "ES2017",
            "DOM"
        ],
        "allowSyntheticDefaultImports": true,
        "sourceMap": false,
        "outDir": "./dist",
        "esModuleInterop": true,
        "rootDir": "./src",
    },
    "exclude": [
        "node_modules"
    ]
}